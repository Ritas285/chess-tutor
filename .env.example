# Copia questo file in .env e inserisci la TUA chiave. Il file .env non va mai caricato su GitHub né condiviso.
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
# Opzionali:
# QDRANT_URL=http://localhost:6333          # vuoto = Qdrant in memoria (nessun Docker)
# PHOENIX_ENDPOINT=http://localhost:6006/v1/traces   # attiva le trace in Phoenix
# ENABLE_METRICS=1                          # espone le metriche Prometheus su :8000
# RAMI_PDF=1                                # accende i rami PDF (regolamento, corsi) se i PDF sono in data/<ramo>/ (vedi README)
