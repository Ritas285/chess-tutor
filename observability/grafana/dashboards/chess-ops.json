{
  "uid": "chess-tutor-ops",
  "title": "Chess Tutor — operazioni",
  "tags": ["chess-tutor"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "type": "text", "title": "", "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": { "mode": "markdown", "content": "**Questa dashboard risponde a: _quanto costa, quanto è lento, quante volte intervengono i guardrail?_** Non sa cosa sia un documento recuperato. Per _perché questa risposta è così?_ si usa Phoenix (http://localhost:6006)." }
    },
    {
      "type": "timeseries", "title": "Latenza per risposta (p50 / p95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(chess_latenza_secondi_bucket[1m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(chess_latenza_secondi_bucket[1m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "type": "timeseries", "title": "Domande al minuto, per esito",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(chess_domande_total[1m])) by (esito) * 60", "legendFormat": "{{esito}}" }
      ]
    },
    {
      "type": "stat", "title": "Costo cumulato della sessione",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 11 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(chess_costo_usd_total)" } ]
    },
    {
      "type": "stat", "title": "Costo medio per domanda",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 11 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 5 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(chess_costo_usd_total) / clamp_min(sum(chess_latenza_secondi_count), 1)" } ]
    },
    {
      "type": "timeseries", "title": "Token al minuto (prompt vs completati)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 11 },
      "targets": [ { "refId": "A", "expr": "sum(rate(chess_token_total[1m])) by (tipo) * 60", "legendFormat": "{{tipo}}" } ]
    },
    {
      "type": "bargauge", "title": "Domande per ramo — dove manda il router?",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 17 },
      "targets": [ { "refId": "A", "expr": "sum(chess_domande_total) by (ramo)", "legendFormat": "{{ramo}}" } ]
    },
    {
      "type": "bargauge", "title": "Chiamate per strumento",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 17 },
      "targets": [ { "refId": "A", "expr": "sum(chess_chiamate_strumento_total) by (strumento)", "legendFormat": "{{strumento}}" } ]
    },
    {
      "type": "bargauge", "title": "Interventi dei guardrail",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 17 },
      "targets": [ { "refId": "A", "expr": "sum(chess_interventi_guardrail_total) by (tipo)", "legendFormat": "{{tipo}}" } ]
    },
    {
      "type": "piechart", "title": "Come sono andate le domande",
      "description": "Totale dall'ultimo avvio dell'app, visto nell'intervallo di tempo scelto in alto a destra: risposte date, domande fuori tema, trucchi fermati dalla barriera.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "options": { "pieType": "donut", "displayLabels": ["percent"], "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "values": ["value", "percent"] }, "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "tooltip": { "mode": "single", "sort": "none" } },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [
        { "matcher": { "id": "byName", "options": "risposta" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
        { "matcher": { "id": "byName", "options": "fuori_tema" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } } ] },
        { "matcher": { "id": "byName", "options": "bloccata" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "targets": [ { "refId": "A", "expr": "sum(last_over_time(chess_domande_total[$__range])) by (esito)", "legendFormat": "{{esito}}", "instant": true, "range": false } ]
    },
    {
      "type": "piechart", "title": "In quale ramo cerca il router",
      "description": "Totale dall'ultimo avvio dell'app, visto nell'intervallo di tempo scelto: quante domande sono andate su ogni ramo (nessuno = fuori tema o bloccata).",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "options": { "pieType": "donut", "displayLabels": ["percent"], "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "values": ["value", "percent"] }, "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "tooltip": { "mode": "single", "sort": "none" } },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(last_over_time(chess_domande_total[$__range])) by (ramo)", "legendFormat": "{{ramo}}", "instant": true, "range": false } ]
    },
    {
      "type": "piechart", "title": "Quanto sono veloci le risposte",
      "description": "Totale dall'ultimo avvio dell'app, visto nell'intervallo di tempo scelto: risposte veloci (fino a 3 secondi), medie (3-8 secondi) e lente (oltre 8 secondi).",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "options": { "pieType": "donut", "displayLabels": ["percent"], "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "values": ["value", "percent"] }, "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "tooltip": { "mode": "single", "sort": "none" } },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [
        { "matcher": { "id": "byName", "options": "Veloci (fino a 3 s)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
        { "matcher": { "id": "byName", "options": "Medie (3-8 s)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } } ] },
        { "matcher": { "id": "byName", "options": "Lente (oltre 8 s)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "targets": [
        { "refId": "A", "expr": "sum(last_over_time(chess_latenza_secondi_bucket{le=\"3.0\"}[$__range]))", "legendFormat": "Veloci (fino a 3 s)", "instant": true, "range": false },
        { "refId": "B", "expr": "sum(last_over_time(chess_latenza_secondi_bucket{le=\"8.0\"}[$__range])) - sum(last_over_time(chess_latenza_secondi_bucket{le=\"3.0\"}[$__range]))", "legendFormat": "Medie (3-8 s)", "instant": true, "range": false },
        { "refId": "C", "expr": "sum(last_over_time(chess_latenza_secondi_count[$__range])) - sum(last_over_time(chess_latenza_secondi_bucket{le=\"8.0\"}[$__range]))", "legendFormat": "Lente (oltre 8 s)", "instant": true, "range": false }
      ]
    },
    {
      "type": "piechart", "title": "Token: domanda contro risposta",
      "description": "Totale dall'ultimo avvio dell'app, visto nell'intervallo di tempo scelto: i token mandati al modello (prompt: domanda e documenti trovati) contro quelli scritti dal modello (completati).",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "options": { "pieType": "donut", "displayLabels": ["percent"], "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "values": ["value", "percent"] }, "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "tooltip": { "mode": "single", "sort": "none" } },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(last_over_time(chess_token_total[$__range])) by (tipo)", "legendFormat": "{{tipo}}", "instant": true, "range": false } ]
    },
    {
      "type": "piechart", "title": "Quali strumenti usa l'agente",
      "description": "Totale dall'ultimo avvio dell'app, visto nell'intervallo di tempo scelto: quante ricerche ha fatto in ogni ramo.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "options": { "pieType": "donut", "displayLabels": ["percent"], "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "values": ["value", "percent"] }, "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "tooltip": { "mode": "single", "sort": "none" } },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(last_over_time(chess_chiamate_strumento_total[$__range])) by (strumento)", "legendFormat": "{{strumento}}", "instant": true, "range": false } ]
    },
    {
      "type": "piechart", "title": "Che cosa fermano i guardrail",
      "description": "Totale dall'ultimo avvio dell'app, visto nell'intervallo di tempo scelto: le difese intervenute, per tipo (domanda bloccata, link rimosso, ecc.).",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "options": { "pieType": "donut", "displayLabels": ["percent"], "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "values": ["value", "percent"] }, "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "tooltip": { "mode": "single", "sort": "none" } },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(last_over_time(chess_interventi_guardrail_total[$__range])) by (tipo)", "legendFormat": "{{tipo}}", "instant": true, "range": false } ]
    }
  ],
  "schemaVersion": 39,
  "version": 2
}
